#!/bin/sh
# Aggiorna js/versione.js con data e ora del commit ("compilazione")
# e lo aggiunge al commit. Attivazione (una volta per clone):
#   git config core.hooksPath .githooks
BASE="1.1.0"
TIMBRO=$(date +%Y%m%d.%H%M)
cat > js/versione.js <<FINE
// File generato automaticamente da .githooks/pre-commit: non modificarlo a mano.
// Per cambiare la versione base modifica BASE nel hook.
const VERSIONE_APP = "$BASE-$TIMBRO";
FINE
git add js/versione.js
